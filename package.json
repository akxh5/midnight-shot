{
  "name": "mn-demo",
  "version": "1.0.0",
  "type": "module",
  "description": "Cryptographic disclosure contract on Midnight Network — Level 2 Rise In Builder Challenge. Level 1 hello-world contract preserved under examples/.",
  "author": "Akshansh",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "compile": "compact compile contracts/disclosure.compact contracts/managed/disclosure",
    "build-tsc": "npx tsc --noEmit || true",
    "setup": "NODE_OPTIONS=\"--max-old-space-size=12288\" npx tsx src/setup.ts",
    "preflight": "npx tsx scripts/preflight-deploy.ts",
    "deploy": "NODE_OPTIONS=\"--max-old-space-size=12288\" npx tsx src/deploy.ts",
    "cli": "NODE_OPTIONS=\"--max-old-space-size=12288\" npx tsx src/cli.ts",
    "check-balance": "NODE_OPTIONS=\"--max-old-space-size=12288\" npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "verify:deploy": "bash scripts/check-deploy.sh"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-dapp-connector-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-provider": "file:./packages/midnight-js-network-provider",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.2.10",
    "postcss": "^8.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
